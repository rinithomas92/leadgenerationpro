# Optional server-side AI generation. Leave blank to use starter templates.
OPENAI_API_KEY=
OPENAI_MODEL=

# Places Discovery: public OSM directory works without commercial API credentials.
PLACES_DISABLED=false
PLACES_OSM_CAP=40
# Optional approved Overpass endpoint; default https://overpass-api.de/api/interpreter
PLACES_OVERPASS_URL=

# Google: configure separate server and HTTP-referrer/API-restricted browser keys.
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
PLACES_GOOGLE_ENABLED=false
PLACES_GOOGLE_CAP=100
PLACES_GOOGLE_FREE_ALLOWANCE_CONFIRMED=false
# ISO timestamp of owner reconciliation, expires after 24 hours.
PLACES_GOOGLE_ALLOWANCE_CHECKED_AT=

# Apple: private .p8 key remains server-side (escaped newlines accepted).
APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
APPLE_MAPS_PRIVATE_KEY=
PLACES_APPLE_ENABLED=false
PLACES_APPLE_CAP=100
PLACES_APPLE_FREE_ALLOWANCE_CONFIRMED=false
PLACES_APPLE_ALLOWANCE_CHECKED_AT=

# Instagram Business Discovery (Facebook Login): server-only credentials.
INSTAGRAM_ENABLED=false
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Set an API version supported by your Meta app, e.g. v27.0.
INSTAGRAM_GRAPH_VERSION=
INSTAGRAM_DAILY_CAP=200
# Optional, required when your app enforces App Secret Proof.
INSTAGRAM_APP_SECRET=

# Instagram keyword account discovery via publicly indexed web profiles.
# Separate from Meta credentials; review the Brave subscription before enabling.
BRAVE_SEARCH_API_KEY=
INSTAGRAM_KEYWORD_ENABLED=false
INSTAGRAM_KEYWORD_DAILY_CAP=20

# Vercel deployment only. Keep actual values in sensitive server-side settings.
LEADGEN_HOSTING=
LEADGEN_DATABASE_URL=
LEADGEN_LOGIN_PASSWORD=
LEADGEN_SESSION_SECRET=
